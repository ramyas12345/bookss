rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images live at images/{uid}/{bookId}/... — anyone can view a
    // book's images (public shelf), but only the owning uid can upload
    // into their own folder, and each file is capped at 2MB to match
    // the app's own limit.
    match /images/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024;
    }
  }
}
